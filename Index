  .home-sections-inner{max-width:1100px;margin:0 auto}
  .home-sections-title{font-size:.7rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--gray-500);margin-bottom:1.5rem}
  .section-cards{display:grid;grid-template-columns:repeat(5,1fr);gap:1rem}
  .section-card{background:white;border-radius:10px;overflow:hidden;cursor:pointer;transition:all .22s;border:1px solid var(--gray-100);box-shadow:0 2px 8px rgba(0,0,0,.04)}
