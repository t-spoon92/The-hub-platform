  .section-card-bar{height:4px}.section-card-bar.sky{background:var(--sky)}.section-card-bar.sage{background:var(--sage)}.section-card-bar.plum{background:var(--plum)}.section-card-bar.sand{background:var(--sand)}.section-card-bar.rose{background:var(--rose)}
