  {title:'Tech Academy events',section:'Get Involved',page:'involved',icon:'🎓',bg:'#FAECED'},
  {title:'THE HUB',section:'Home',page:'home',icon:'✨',bg:'#E6F4F4'},
];
function handleSearch(val){const overlay=document.getElementById('searchOverlay');const list=document.getElementById('searchResultsList');const header=document.getElementById('searchResultsHeader');if(!val.trim()){overlay.classList.remove('visible');return}const q=val.toLowerCase();const results=searchData.filter(d=>d.title.toLowerCase().includes(q)||d.section.toLowerCase().includes(q)).slice(0,8);header.textContent=results.length>0?`${results.length} result${results.length!==1?'s':''} for "${val}"`:(`No results found for "${val}"`);list.innerHTML=results.length===0?'<div style="padding:1.5rem;text-align:center;color:#6b7f93;font-size:.875rem">Try "Copilot", "risk framework", or "events"</div>':results.map(r=>`<div class="search-result-item" onmousedown="showPage('${r.page}');closeSearch()"><div class="result-icon" style="background:${r.bg}">${r.icon}</div><div><div class="result-title">${r.title}</div><div class="result-section">${r.section}</div></div></div>`).join('');overlay.classList.add('visible')}
function closeSearch(){setTimeout(()=>{document.getElementById('searchOverlay').classList.remove('visible');document.getElementById('searchInput').value=''},150)}
function focusSearch(){document.getElementById('searchInput').focus()}
document.addEventListener('keydown',e=>{if(e.key==='Escape')closeSearch()});
</script>
